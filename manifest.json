{
  "manifest_version": 3,
  "name": "Crossword Date Navigator",
  "author": "www.sandroid.dev",
  "version": "1.1.0",
  "description": "Navigate NYT Mini, Midi and Daily crosswords by year, month or day with on-screen buttons and keyboard shortcuts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/crosswords/game/mini*",
        "https://www.nytimes.com/crosswords/game/midi*",
        "https://www.nytimes.com/crosswords/game/daily*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "navigation.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crossword Date Navigator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
